NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Final public site URL (HTTPS origin only, no trailing slash). Used for Next.js metadataBase
# and canonical absolute URLs. Example: https://your-app.netlify.app or https://tasks.example.com
# On Netlify you can omit this if the automatic `URL` env is enough at build time.
NEXT_PUBLIC_SITE_URL=

# --- Netlify / production ---
# NEXT_PUBLIC_SUPABASE_URL must be the HTTPS project URL from Supabase (…supabase.co),
# NOT a postgresql://… DSN and NOT a LAN IP. This app does not connect to Postgres directly for auth/data.
# Optional ODOO_DATABASE_NAME is only for XML-RPC «API mode»; in «Browser session» mode it is ignored for login.
# If ODOO_DATABASE_NAME points at a DB that does not exist on the Odoo server, Odoo may return a PostgreSQL error.

# Optional: reminder emails (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ERP Tasks <onboarding@resend.dev>

# Optional: Vercel Cron + same value in Vercel project env as CRON_SECRET
CRON_SECRET=
# GET /api/cron/check-expirations — same Bearer CRON_SECRET
# Days-before-due window for corporate_tasks (company_documents use per-row alert_days_before)
CORPORATE_TASK_EXPIRY_ALERT_DAYS=7

# Phase 5 — AI agent & encrypted credential vault (32-byte key, base64 or 64 hex chars)
CREDENTIALS_ENCRYPTION_KEY=

# Unified LLM stack (server only): Gemini (default for text) → Groq → OpenAI
# Keys must be ASCII/Latin-1 only (real tokens). Arabic placeholder text breaks HTTP headers (ByteString).
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# https://console.groq.com — OpenAI-compatible API (used first for chat tools when set)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional third fallback / chat tools if GROQ_API_KEY is unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Odoo (optional overrides — default model project.task, domain = open stages + assigned to login user)
ODOO_TASK_MODEL=project.task
# Optional custom search_read domain for inbound scan / XML-RPC open tasks. Put the literal __ODOO_UID__ where the Odoo user id must appear (replaced before parse; do not hard-code [1] from old examples).
# ODOO_OPEN_TASK_DOMAIN_JSON=[["&",["|",["user_ids","in",[__ODOO_UID__]],["user_id","=",__ODOO_UID__]],["|",["stage_id","=",false],["stage_id.fold","=",false]]]]

# Optional: From address for SMTP replies (if smtp username is not a full email)
SMTP_FROM_EMAIL=

# Dev-only: Odoo agenda self-test (POST /api/dev/odoo-agenda-self-test). Requires npm run dev.
# Header: x-odoo-self-test-secret: <same value>
ODOO_AGENDA_SELF_TEST_SECRET=
# Never enable on public production unless you understand the risk.
ALLOW_ODOO_AGENDA_SELF_TEST_PROD=
